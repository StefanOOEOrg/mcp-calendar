# Local configuration for mcp-calendar (git-ignored — see .gitignore).
# Copy to .env and fill in. Never commit real values.

# Multi-calendar: single-line JSON object {"Name": "ICS share URL", ...}
CALENDAR_URLS={"My calendar": "https://calendar.proton.me/...", "Family": "https://calendar.proton.me/..."}

# Single calendar instead (used only when CALENDAR_URLS is unset; name is "default")
# CALENDAR_ICS_URL=https://calendar.proton.me/...

# Optional: IANA time zone for "now" and day boundaries
# CALENDAR_TIMEZONE=Europe/Vienna

# Optional: seconds per ICS fetch
# CALENDAR_FETCH_TIMEOUT=20

# Invitations (the create_event_invite tool appears only with CALENDAR_INVITE_TO set)
# CALENDAR_INVITE_TO=you@example.com
# CALENDAR_INVITE_FROM=organizer@example.com   # default: same as CALENDAR_INVITE_TO
# CALENDAR_HIMALAYA=himalaya                    # path of the himalaya CLI
# CALENDAR_MAIL_TIMEOUT=60                      # seconds for one mail call

# Direct write path (the create_event tool appears only with CALENDAR_PROTON_CAL set).
# Requires the proton-cal binary (v0.1.2) and a one-time `proton-cal login` on this
# machine — the session lives in ~/.config/proton-cal/ (mode 0600), never in the repo.
# CALENDAR_PROTON_CAL=/home/hermes/.local/bin/proton-cal
# CALENDAR_PROTON_CALENDAR=Privat               # default: the CLI's own calendar
# CALENDAR_PROTON_TIMEOUT=60                    # seconds for one proton-cal call
